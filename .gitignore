# =========================
# 1. Python 编译文件与缓存
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 2. 你的项目中需要过滤的打包产物
# =========================
# 过滤打包时生成的 build 和 dist 文件夹
temp/
build/
dist/
example/*.p[n|d][g|f]
# 过滤项目本身生成的 egg-info 目录 (截图中的 src/AsmSV.egg-info)
*.egg-info/
*.egg
*.vcf*
*.log
*.png
*bench*
*.txt*
# =========================
# 3. 虚拟环境 (预防你未来在目录下创建虚拟环境)
# =========================
venv/
env/
.env
src/AsmSV/*.txt
# =========================
# 4. 编辑器与系统生成文件
# =========================
# VS Code / PyCharm 配置
.vscode/
.idea/

# macOS / Windows 系统文件
.DS_Store
Thumbs.db